    // --- MODAL CREACIÓN DE RUBRO (desde Articulos) --- //
    function AbrirModalCrearRubro() {
        document.getElementById('crearNombre').value = "";

        const modal = new bootstrap.Modal(document.getElementById('modalCrearRubro'));
        modal.show();
    }

    document.getElementById('formCrearRubro').addEventListener('submit', async function (e) {
        e.preventDefault();

        const form = e.target;
        const formData = new FormData(form);

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            });

            const data = await response.json();

            if (data.success) {
                const select = document.getElementById('SelectRubroId');
                const option = document.createElement('option');
                option.value = data.id;
                option.text = data.nombre;
                select.appendChild(option);
                select.value = data.id;

                bootstrap.Modal.getInstance(document.getElementById('modalCrearRubro')).hide();
            } else {
                alert(data.error || 'No se pudo crear el rubro.');
            }
        } catch (err) {
            alert('Ocurrió un error al crear el rubro.');
        }
    });

    // --- MODAL CREACIÓN DE MARCA (desde Articulos) --- //
    function AbrirModalCrearMarca() {
        document.getElementById('crearMarcaCodigo').value = "";
        document.getElementById('crearMarcaNombre').value = "";

        const modal = new bootstrap.Modal(document.getElementById('modalCrearMarca'));
        modal.show();
    }

    document.getElementById('formCrearMarca').addEventListener('submit', async function (e) {
        e.preventDefault();

        const codigo = document.getElementById('crearMarcaCodigo').value.trim();
        const nombre = document.getElementById('crearMarcaNombre').value.trim();

        if (codigo === "" || nombre === "") {
            alert("Complete todos los campos.");
            return;
        }

        try {
            const response = await fetch('@Url.Action("Crear", "Marca", new { area = "Ventas" })', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ codigo: codigo, nombre: nombre })
            });

            if (response.ok) {
                const data = await response.json();
                const select = document.getElementById('BrendId');
                const option = document.createElement('option');
                option.value = data.id;
                option.text = data.nombre;
                select.appendChild(option);
                select.value = data.id;

                bootstrap.Modal.getInstance(document.getElementById('modalCrearMarca')).hide();
            } else {
                const error = await response.text();
                alert(error || 'No se pudo crear la marca.');
            }
        } catch (err) {
            alert('Ocurrió un error al crear la marca.');
        }
    });

