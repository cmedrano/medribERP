@using PresupuestoMVC.Areas.Ventas.ViewModels.DTOs
@model IEnumerable<ArticuloResponseDTO>
@using PresupuestoMVC.Models.DTOs

@{
    Layout = PresupuestoMVC.Helpers.LayoutHelper.Resolve(Context);
    ViewData["Title"] = "Artículos";
    var productCategories = ViewBag.ProductCategories as IEnumerable<ProductCategoryResponseDto>;
    var brands = ViewBag.Brands as IEnumerable<BrandResponseDto>;
    var providers = ViewBag.Providers as IEnumerable<ProviderResponseDto>;
    var priceList = ViewBag.PriceList;
    var marcaMasPopular = Model.GroupBy(x => x.BrendId)
        .OrderByDescending(g => g.Count())
        .FirstOrDefault();
    var nombreMarca = brands?
        .FirstOrDefault(x => x.Id == marcaMasPopular?.Key)?.Name ?? "Sin marca";
}
<main class="flex-grow-1 container-main">
    <!-- Header -->
    <div class="topbar">
        <form method="get" asp-action="Index" class="searchbox">
            <div>
                <i class="bi bi-search"></i>
                <input class="form-control"
                       type="text"
                       name="searchArticulo"
                       value="@ViewData["SearchArticulo"]"
                       placeholder="Buscar articulo..." />
            </div>
        </form>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-success-soft"
                    onclick="abrirModalArticulo(true)">
                <i class=" bi bi-plus-lg me-2" id="btnNuevoArticulo"></i>
                Nuevo articulo
            </button>
        </div>
    </div>
    <div class="page-head">
        <div>
            <h1 class="page-title">@ViewData["Title"]</h1>
            <p class="page-subtitle">Gestión de artículos y productos.</p>
        </div>
    </div>

    <!-- informacion util rapida -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="erp-card metric-card">
                <div class="metric-icon"><i class="bi bi-journal-text"></i></div>
                <div class="metric-label">Cantidad total de articulos</div>
                <div class="metric-value">@Model.Count()</div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="erp-card metric-card">
                <div class="metric-icon"><i class="bi bi-star"></i></div>
                <div class="metric-label">Marca mas popular</div>
                <div class="metric-value">@nombreMarca</div>
            </div>
        </div>

        @* <div class="col-md-6 col-xl-3">
            <div class="erp-card metric-card">
                <div class="metric-icon"><i class="bi bi-toggle-on"></i></div>
                <div class="metric-label">Articulos activos</div>
                <div class="metric-value">@Model.Count(x => x.Activo)</div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="erp-card metric-card">
                <div class="metric-icon"><i class="bi bi-toggle-off"></i></div>
                <div class="metric-label">Articulos no activos</div>
                <div class="metric-value">@Model.Count(x => !x.Activo)</div>
            </div>
        </div> *@
    </div>

    <div id="tablaContainer">
        @await Html.PartialAsync("_TablaArticulosPartial", Model)
    </div>
</main>


<!-- Modal Articulo (Crear/Ver/Editar) -->
<div class="modal fade erp-modal-body" id="modalArticulo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog  modal-xl erp-modal">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="erp-modal-header">
                <h2 class="erp-modal-title" id="modalArticuloTitle"></h2>
                <button class="erp-modal-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <form id="formArticulo" method="post">
                <div class="modal-body erp-modal-body p-4 bg-white">
                    <input type="hidden" name="Id" id="articuloId">
                       <!-- tabla donde se guardarán los precios -->
                       <div id="priceContainer"></div>
                    <div id="hiddenItemsContainer"></div>
                    <div class="row g-4">
                        <section class="erp-form-section">
                            <!-- Datos Básicos -->
                            <h3 class="erp-form-section-title">Datos del artículo</h3>
                            <div class="row g-3 mb-3">
                                <!-- Codigo -->
                                <div class="col-md-4" id="divCodigo">
                                    <label class="form-label">Codigo</label>
                                    <input type="text" name="Codigo" id="articuloCodigo" class="form-control" placeholder="Ej. fda-123" required>
                                </div>
                                <!-- Nombre -->
                                <div class="col-md-4" id="divNombre">
                                    <label class="form-label">Nombre</label>
                                    <input type="text" name="Nombre" id="articuloNombre" class="form-control" placeholder="Ej. Richard" required>
                                </div>
                                <!-- Unidad de medida -->
                                <div class="col-md-4" id="divUnidadDeMedida">
                                    <label class="form-label">Unidad de medida</label>
                                    <input type="text" name="UnidadMedida" id="articuloUnidadMedida" class="form-control" placeholder="Ej. Kg" required>
                                </div>
                                <!-- Rubro -->
                                <div class="col-md-4">
                                    <label for="SelectRubroId" class="form-label">Rubro</label>
                                    <div class="input-group">
                                        <select id="SelectRubroId" name="ProductCategoryId"
                                                class="form-select" required>
                                            <option value="">Seleccionar rubro...</option>
                                            @if (productCategories != null)
                                            {
                                                foreach (var productCategory in productCategories)
                                                {
                                                    <option value="@productCategory.Id">@productCategory.Name</option>
                                                }
                                            }
                                        </select>
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                title="Nuevo rubro"
                                                id="btnNuevoRubroDesdeArticulo"
                                                onclick="AbrirModalCrearRubro()">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>
                                <!-- Marca -->
                                <div class="col-md-4">
                                    <label class="form-label">Marca</label>
                                    <div class="input-group">
                                        <select id="BrendId" name="BrendId"
                                                class="form-select" required>
                                            <option value="">Seleccionar marca...</option>
                                            @if (brands != null)
                                            {
                                                foreach (var brend in brands)
                                                {
                                                    <option value="@brend.Id">@brend.Name</option>
                                                }
                                            }
                                        </select>
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                title="Nueva marca"
                                                id="btnNuevaMarcaDesdeArticulo"
                                                onclick="AbrirModalCrearMarca()">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>
                                <!-- Proveedor -->
                                <div class="col-md-4">
                                    <label class="form-label">Proveedor</label>
                                    <div class="input-group">
                                        <select id="providerId" name="ProviderId"
                                                class="form-select" required>
                                            <option value="">Seleccionar proveedor...</option>
                                            @if (providers != null)
                                            {
                                                foreach (var provider in providers)
                                                {
                                                    <option value="@provider.Id">@provider.Company</option>
                                                }
                                            }
                                        </select>
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                title="Nuevo proveedor"
                                                id="btnNuevoProveedorDesdeArticulo"
                                                onclick="AbrirModalCrearProveedor()">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>
                                <!-- Precio de compra -->
                                <div class="col-md-4">
                                    <label class="form-label">Precio de compra</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-0">
                                            <i class="bi bi-currency-dollar"></i>
                                        </span>
                                        <input type="number"
                                               name="PurchasePrice"
                                               id="PurchasePrice"
                                               placeholder="0"
                                               class="form-control"
                                               required>
                                    </div>
                                </div>
                                <!-- Precio de venta -->
                                <div class="col-md-4">
                                    <label class="form-label">Precio de venta</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-0">
                                            <i class="bi bi-currency-dollar"></i>
                                        </span>
                                        <input type="number"
                                               name="SalePrice"
                                               id="salePrice"
                                               placeholder="0"
                                               class="form-control"
                                               required>
                                    </div>
                                </div>
                                
                                <!-- lista -->
                                <div class="col-md-4">
                                    <label class="form-label">Lista de precios</label>
                                    <div class="input-group btn-lista">
                                        <button type="button"
                                                class="btn-orange-soft"
                                                title="Ver"
                                                onclick="abrirModalLista()">
                                            <i class="bi bi-list me-1"></i>
                                            Abrir lista
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
                <div class="erp-modal-footer">
                    <button type="button" class="btn btn-soft btn-pill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-pill" id="btnSubmitForm"></button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal de Creación de Rubro (desde Articulos) -->
<div class="modal fade" id="modalCrearRubro" tabindex="-1">
    <div class="modal-dialog erp-modal">
        <div class="modal-content border-0 shadow-lg">

            <!-- Header -->
            <div class="erp-modal-header">
                <h5 class="erp-modal-title" id="modalRubroTitle">
                    <i class="bi bi-box"></i> Nuevo Rubro
                </h5>
                <button class="erp-modal-close"
                        type="button"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <form id="formCrearRubro" action="@Url.Action("CreateProductCategory", "ProductCategory", new { area = "Ventas" })" method="post">

                <div class="modal-body d-flex gap-2 p-4">
